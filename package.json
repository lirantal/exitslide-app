{
  "name": "exitslide",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @exitslide/frontend dev",
    "build": "pnpm -r --if-present build",
    "build:pr-preview": "CLOUDFLARE_PREVIEW_BUILD=true pnpm --filter @exitslide/frontend exec vite build --mode pr-preview",
    "deploy:pr-preview": "pnpm --filter @exitslide/frontend exec cf previews deploy --prebuilt --mode pr-preview",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "cf": "1.0.0-rc.2",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
