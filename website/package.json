{
  "name": "@exitslide/website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:pr-preview": "CLOUDFLARE_PREVIEW_BUILD=true vite build --mode pr-preview",
